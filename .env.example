# Drama D-N0 / D-N1 runtime. Default provider is fixture (no API key).
AIV_DATA_DIR=./data
AIV_LLM_PROVIDER=fixture
AIV_REPO_ROOT=.

# Only needed when provider=llm
# AIV_OPENAI_API_KEY=
# AIV_OPENAI_BASE_URL=https://api.openai.com/v1
# AIV_OPENAI_MODEL=gpt-4o-mini

# BRIEF-AIV-017a O5: named-cast check (default warn). error = hard FAIL; off = debug only.
# AIV_NAMED_CAST_CHECK=warn

# AIV-032 gold-A sheet (Ark Seedream). Never commit a real key. Prefer env or file, never echo.
# ARK_API_KEY=
# ARK_API_KEY_FILE=~/.config/aiv/ARK_API_KEY
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
