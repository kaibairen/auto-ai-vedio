# Drama D-N0 / D-N1 runtime. Default provider is fixture (no API key).
AIV_DATA_DIR=./data
AIV_LLM_PROVIDER=fixture
AIV_REPO_ROOT=.

# Only needed when provider=llm (N1/N2/N3 thicken). Isolated from look image keys.
# AIV_OPENAI_API_KEY=
# AIV_OPENAI_BASE_URL=https://api.openai.com/v1
# AIV_OPENAI_MODEL=gpt-4o-mini

# AIV-031 image providers — HARD isolated from DeepSeek text keys above.
# Do not reuse AIV_OPENAI_API_KEY / OPENAI_API_KEY for Ark or DashScope.
# Live Seedream/wan clients live in drama-look-core; image_providers.py is a hook only.
# ARK_API_KEY=
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# AIV_LOOK_SKU=doubao-seedream-5-0-flash-260915
# AIV_LOOK_STYLE_REF=

# BRIEF-AIV-017a O5: named-cast check (default warn). error = hard FAIL; off = debug only.
# AIV_NAMED_CAST_CHECK=warn
