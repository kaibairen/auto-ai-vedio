{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Episode",
  "type": "object",
  "required": ["episode_id", "project_id", "pipeline_profile", "status"],
  "properties": {
    "episode_id": { "type": "string", "pattern": "^EP\\d{2,}$" },
    "project_id": { "type": "string" },
    "pipeline_profile": { "type": "string", "const": "drama" },
    "status": {
      "type": "string",
      "enum": ["draft", "in_progress", "awaiting_g1b", "locked_g1b", "abandoned", "failed"]
    },
    "locks": {
      "type": "object",
      "properties": { "g1b": { "type": "boolean" } }
    },
    "intent": {
      "type": "object",
      "properties": {
        "confirmed": { "type": "boolean" },
        "fingerprint": { "type": ["string", "null"] },
        "confirmed_at": { "type": ["string", "null"] },
        "confirmed_by": { "type": ["string", "null"] }
      }
    },
    "versions": {
      "type": "object",
      "properties": {
        "brief": { "type": "integer" },
        "outline": { "type": "integer" },
        "cast": { "type": "integer" },
        "storyboard": { "type": "integer" }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "g1b": { "type": "object" },
        "g2": { "type": "object" }
      }
    },
    "storyboard_meta": {
      "type": "object",
      "properties": {
        "shot_cap": { "type": "integer" },
        "storyboard_skill": { "type": ["string", "null"] },
        "skill_paths": { "type": "array", "items": { "type": "string" } },
        "tool_profile": { "type": ["string", "null"] }
      }
    },
    "projection_dirty": { "type": "boolean" },
    "stale_downstream": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
